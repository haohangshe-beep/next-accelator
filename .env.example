# Backend (read from the process environment; this file is not loaded automatically)
FTOS_DATABASE_URL=sqlite:///./ftos.db
FTOS_SECRET=dev-ftos-secret-change-me-0123456789

# Frontend
# Leave NEXT_PUBLIC_API_URL unset to call /api/v1 on the Next.js origin.
# The rewrite in frontend/next.config.ts proxies that to the backend.
# API_PROXY_TARGET=http://127.0.0.1:8000
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
